{
  // Generated by `wxt prepare` (runs first inside root `typecheck`).
  // Strict flags repeat tsconfig.base.json so the extension stays strict
  // even if the generated config is ever less strict.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["entrypoints", "src", "tests", "wxt.config.ts", ".wxt/wxt.d.ts"]
}
