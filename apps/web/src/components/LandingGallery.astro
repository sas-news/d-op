---
// Feature gallery ported from the legacy gh-pages site (task 21). The slides
// are the project's own store-listing screenshots shipped same-origin under
// img-src 'self'. Interaction (carousel + lightbox) lives in
// public/landing.js; without JavaScript the first slide stays visible and
// every image still loads.
const SLIDES = [
  {
    src: "/assets/store-image1.png",
    alt: "dアニメストアの作品一覧に「OP/ED」ボタンが追加。シークバー上にOP/EDを自動表示。プレイリスト化。",
  },
  {
    src: "/assets/store-image2.png",
    alt: "好きなOP/EDやシーンをプレイリストに保存。連続再生、シャッフル再生が可能。",
  },
  {
    src: "/assets/store-image3.png",
    alt: "プレイリストの管理画面で、新規作成や順番の入れ替えが可能。",
  },
] as const
---

<div class="gallery" data-gallery data-testid="gallery">
  <div class="gallery-stage" aria-roledescription="carousel" aria-label="拡張機能の紹介画像">
    <ul class="gallery-track" data-gallery-track>
      {
        SLIDES.map((slide, index) => (
          <li class:list={["gallery-slide", { "is-active": index === 0 }]} data-slide data-index={index}>
            <button
              class="gallery-image-btn"
              type="button"
              data-lightbox-trigger
              data-index={index}
              aria-label={`紹介画像${index + 1}を拡大`}
            >
              <img class="gallery-image" src={slide.src} alt={slide.alt} loading="lazy" decoding="async" />
            </button>
          </li>
        ))
      }
    </ul>
    <button class="gallery-nav gallery-nav-prev" type="button" data-gallery-prev aria-label="前の画像">
      <svg viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true"><path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button class="gallery-nav gallery-nav-next" type="button" data-gallery-next aria-label="次の画像">
      <svg viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true"><path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </div>

  <ul class="gallery-thumbs" role="tablist" aria-label="紹介画像選択">
    {
      SLIDES.map((slide, index) => (
        <li role="presentation">
          <button
            class:list={["gallery-thumb", { "is-active": index === 0 }]}
            type="button"
            role="tab"
            data-gallery-thumb
            data-index={index}
            aria-selected={index === 0 ? "true" : "false"}
            aria-label={`紹介画像${index + 1}を表示`}
          >
            <img src={slide.src} alt="" loading="lazy" decoding="async" />
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .gallery-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .gallery-track {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms ease-out;
  }

  .gallery-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .gallery-image-btn {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: zoom-in;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    background: #000;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .gallery-nav {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    background: rgb(10 10 12 / 72%);
    color: var(--color-ink);
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(6px);
    transition:
      background var(--motion-fast),
      border-color var(--motion-fast),
      color var(--motion-fast),
      transform var(--motion-fast);
  }

  .gallery-nav:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .gallery-nav:active {
    transform: translateY(-50%) scale(0.96);
  }

  .gallery-nav-prev {
    left: var(--space-3);
  }

  .gallery-nav-next {
    right: var(--space-3);
  }

  .gallery-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-thumb {
    flex: 0 0 auto;
    width: 6rem;
    height: 4rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
    opacity: 0.6;
    transition:
      border-color var(--motion-fast),
      transform var(--motion-fast),
      opacity var(--motion-fast);
  }

  .gallery-thumb:hover {
    opacity: 1;
    transform: translateY(-0.0625rem);
  }

  .gallery-thumb.is-active {
    border-color: var(--color-accent);
    opacity: 1;
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 45rem) {
    .gallery-thumb {
      width: 4.5rem;
      height: 3rem;
    }

    .gallery-nav {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-slide {
      transition: none;
    }
  }
</style>
