---
// Save/install shell for /p/:shareId (tasks 16+17). The open button stays
// disabled until share-page.js detects the extension marker
// (data-dop-extension on <html>); when active, clicking it posts ONLY the
// shareId + a correlation requestId to the extension relay — never playlist
// JSON. `shareId` is the SSR-authoritative id of this snapshot.
interface Props {
  shareId: string
}
const { shareId } = Astro.props
---

<section class="section" aria-labelledby="save-title" data-testid="save-panel">
  <div class="section-heading">
    <div>
      <p class="section-eyebrow">Save</p>
      <h2 id="save-title">d-OP で保存する</h2>
    </div>
    <p>プレイリストはブラウザのローカルストレージに保存されます。</p>
  </div>
  <div class="save-card">
    <p class="save-lead">
      この共有プレイリストは、d-OP
      拡張機能をインストールしたブラウザで開いて保存できます。アカウントやログインは不要です。
    </p>
    <div class="button-row">
      <button
        type="button"
        class="button button-primary"
        disabled
        aria-disabled="true"
        data-share-save
        data-share-id={shareId}
        data-testid="save-open-button"
      >
        d-OP で開く
      </button>
      <a
        class="button button-secondary"
        href="https://chromewebstore.google.com/detail/d-op/mcjkaoagedekadnimbcbkhdkgpbnnodc"
        target="_blank"
        rel="noopener noreferrer"
        data-testid="save-chrome-link"
      >
        Chrome 版を入手
      </a>
      <a
        class="button button-secondary"
        href="https://addons.mozilla.org/ja/firefox/addon/d-op/"
        target="_blank"
        rel="noopener noreferrer"
        data-testid="save-firefox-link"
      >
        Firefox 版を入手
      </a>
    </div>
    <p class="save-status" role="status" data-share-save-status data-testid="save-status">
      d-OP
      拡張機能が見つかりません。インストールすると、このページから直接プレイリストを保存できるようになります。
    </p>
  </div>
</section>

<style>
  .save-card {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-accent-soft), var(--color-surface));
    box-shadow: var(--shadow-soft);
  }

  .save-lead {
    max-inline-size: 40rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .save-status {
    margin-top: var(--space-4);
    color: var(--color-subtle);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
</style>
