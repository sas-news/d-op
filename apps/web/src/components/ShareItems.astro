---
import type { SharePageItemView } from "../server/services/share-page"

// Public clip list for /p/:shareId (task 16). Every user-controlled string
// renders as escaped text via Astro expressions — never set:html — so
// script-like metadata stays inert. Long Japanese metadata wraps via
// overflow-wrap instead of overflowing the card.
interface Props {
  items: readonly SharePageItemView[]
}

const { items } = Astro.props
---

<section class="section" aria-labelledby="share-items-title">
  <h2 id="share-items-title" class="share-items-title">
    クリップ一覧（{items.length}）
  </h2>
  <ol class="share-items" data-testid="share-items">
    {items.map((item) => (
      <li class="share-item" data-testid="share-item">
        <span class="share-item-index" aria-hidden="true">{item.index}</span>
        <div class="share-item-body">
          <p class="share-item-episode">{item.primaryLabel}</p>
          <p class="share-item-work">{item.title}</p>
          {item.rangeName !== null && (
            <p class="share-item-range-name">{item.rangeName}</p>
          )}
        </div>
        <div class="share-item-time">
          <span class="share-item-range">{item.rangeLabel}</span>
          <span class="share-item-duration">{item.durationLabel}</span>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .share-items-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .share-items {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: share-item;
  }

  .share-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .share-item-index {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .share-item-body {
    min-width: 0;
  }

  .share-item-episode {
    font-weight: 700;
    overflow-wrap: break-word;
  }

  .share-item-work {
    margin-top: var(--space-1);
    color: var(--color-subtle);
    font-size: var(--text-xs);
    overflow-wrap: break-word;
  }

  .share-item-range-name {
    margin-top: var(--space-1);
    color: var(--color-accent-bright);
    font-size: var(--text-sm);
    font-weight: 700;
    overflow-wrap: break-word;
  }

  .share-item-time {
    display: grid;
    gap: var(--space-1);
    justify-items: end;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .share-item-range {
    color: var(--color-subtle);
  }

  .share-item-duration {
    color: var(--color-accent-bright);
    font-weight: 700;
  }

  @media (max-width: 30rem) {
    .share-item {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .share-item-time {
      grid-column: 1 / -1;
      grid-auto-flow: column;
      justify-items: start;
      gap: var(--space-3);
    }
  }
</style>
