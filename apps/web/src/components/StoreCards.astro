---
// Store install cards ported from the legacy gh-pages download section
// (task 21). Links are the official published listings.
import ChromeLogo from "./ChromeLogo.astro"
import FirefoxLogo from "./FirefoxLogo.astro"
---

<div class="store-grid">
  <a
    class="store-card"
    data-testid="chrome-store-link"
    href="https://chromewebstore.google.com/detail/d-op/mcjkaoagedekadnimbcbkhdkgpbnnodc"
    rel="noopener"
    target="_blank"
  >
    <span class="store-card-badge" aria-hidden="true"><ChromeLogo /></span>
    <span class="store-card-body">
      <span class="store-card-eyebrow">Chrome Web Store</span>
      <span class="store-card-title">Chrome 版を入手</span>
      <span class="store-card-desc">Google Chrome / Vivaldi / Brave などの Chromium 系ブラウザに対応。</span>
    </span>
    <span class="store-card-arrow" aria-hidden="true">→</span>
  </a>
  <a
    class="store-card"
    data-testid="firefox-store-link"
    href="https://addons.mozilla.org/ja/firefox/addon/d-op/"
    rel="noopener"
    target="_blank"
  >
    <span class="store-card-badge" aria-hidden="true"><FirefoxLogo /></span>
    <span class="store-card-body">
      <span class="store-card-eyebrow">Firefox Add-ons</span>
      <span class="store-card-title">Firefox 版を入手</span>
      <span class="store-card-desc">Firefox / Zen Browser / Floorp などの Gecko 系ブラウザに対応。</span>
    </span>
    <span class="store-card-arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .store-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color var(--motion-base),
      background-color var(--motion-base),
      transform var(--motion-base);
  }

  .store-card:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-raised);
    transform: translateY(-0.125rem);
  }

  .store-card-badge {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  .store-card-body {
    display: grid;
    flex: 1 1 auto;
    min-width: 0;
  }

  .store-card-eyebrow {
    margin-bottom: var(--space-1);
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .store-card-title {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .store-card-desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .store-card-arrow {
    flex: 0 0 auto;
    color: var(--color-subtle);
    font-size: var(--text-xl);
    transition:
      color var(--motion-fast),
      transform var(--motion-fast);
  }

  .store-card:hover .store-card-arrow {
    color: var(--color-accent);
    transform: translateX(0.125rem);
  }

  @media (max-width: 48rem) {
    .store-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
