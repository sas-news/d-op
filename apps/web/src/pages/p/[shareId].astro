---
import ErrorShell from "../../components/ErrorShell.astro"
import ShareItems from "../../components/ShareItems.astro"
import ShellLayout from "../../layouts/ShellLayout.astro"
import { newRequestId } from "../../server/services/respond"
import { loadSharePage } from "../../server/services/share-page"

// GET /p/:shareId — the public snapshot page (task 16). Fully server-rendered:
// every state (found / notfound / unavailable) is decided here and works with
// JavaScript disabled. Unknown, pending, blocked, deleted and malformed ids
// all render the SAME nonrevealing 404 view — no existence oracle. Manage
// secrets, capability URLs and admin controls never reach this markup.

const result = await loadSharePage(Astro.params["shareId"], Astro.request, newRequestId())

if (result.kind === "notfound") {
  Astro.response.status = 404
} else if (result.kind === "unavailable") {
  Astro.response.status = result.status
  if (result.retryAfter !== null) {
    Astro.response.headers.set("retry-after", result.retryAfter)
  }
}

const NOT_FOUND_TITLE = "共有プレイリストが見つかりません"
const NOT_FOUND_MESSAGE =
  "この共有プレイリストは存在しないか、公開されていません。URLを確認してください。"

const title =
  result.kind === "ready" ? `${result.view.title} | d-OP Share` : `${NOT_FOUND_TITLE} | d-OP Share`
const description =
  result.kind === "ready" ? result.view.ogDescription : "共有プレイリストは見つかりませんでした。"
---

<ShellLayout title={title} description={description}>
  <Fragment slot="head">
    {result.kind === "ready" ? (
      <>
        <link rel="canonical" href={result.view.canonicalUrl} />
        {(result.view.visibility === "unlisted" || result.view.remix.page > 1) && (
          <meta name="robots" content="noindex" />
        )}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="d-OP Share" />
        <meta property="og:title" content={result.view.ogTitle} />
        <meta property="og:description" content={result.view.ogDescription} />
        <meta property="og:url" content={result.view.canonicalUrl} />
        <meta property="og:image" content={result.view.ogImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={result.view.ogImageUrl} />
        <meta name="twitter:title" content={result.view.ogTitle} />
        <meta name="twitter:description" content={result.view.ogDescription} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
  </Fragment>

  {result.kind === "ready" ? (
    <>
      <section class="share-hero" aria-labelledby="share-title">
        <p class="hero-eyebrow" data-testid="share-visibility">
          {result.view.visibility === "public" ? "公開プレイリスト" : "限定公開プレイリスト"}
        </p>
        <h1 id="share-title" class="share-title" data-testid="share-title">
          {result.view.title}
        </h1>
        {result.view.author !== "" && (
          <p class="share-author" data-testid="share-author">
            {result.view.author}
          </p>
        )}
        {result.view.description !== "" && (
          <p class="share-description" data-testid="share-description">
            {result.view.description}
          </p>
        )}
        <p class="share-meta" data-testid="share-stats">
          <span>
            <strong data-testid="share-clip-count">{result.view.clipCount}</strong> クリップ
          </span>
          <span aria-hidden="true">·</span>
          <span>
            合計 <strong data-testid="share-total-duration">{result.view.totalDurationLabel}</strong>
          </span>
          <span aria-hidden="true">·</span>
          <span>{result.view.importCount} 回保存</span>
          <span aria-hidden="true">·</span>
          <span>{result.view.publishedAtLabel} 公開</span>
        </p>
        {result.view.tags.length > 0 && (
          <ul class="share-tags" data-testid="share-tags" aria-label="タグ">
            {result.view.tags.map((tag) => <li class="share-tag">{tag}</li>)}
          </ul>
        )}
        {result.view.sourceUrl !== null && (
          <p class="share-source" data-testid="share-source">
            このプレイリストは
            <a href={result.view.sourceUrl}>公開プレイリスト</a>
            の Remix です。
          </p>
        )}
        <div class="button-row share-actions" data-testid="save-panel">
          <button
            type="button"
            class="button button-primary"
            disabled
            aria-disabled="true"
            data-share-save
            data-share-id={result.view.shareId}
            data-testid="save-open-button"
          >
            d-OP で開く
          </button>
          <button
            type="button"
            class="button button-secondary"
            disabled
            aria-disabled="true"
            data-share-copy
            data-copy-url={result.view.canonicalUrl}
            data-testid="copy-url-button"
          >
            URLをコピー
          </button>
          <a
            class="button button-secondary"
            href={result.view.xIntentUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-testid="share-x-link"
          >
            Xで共有
          </a>
        </div>
        <p class="share-status-line">
          <span class="save-status" role="status" data-share-save-status data-testid="save-status">
            d-OP
            拡張機能が必要です。インストール後、このページを再読み込みしてください。
          </span>
          <span class="share-status-stores" data-share-stores>
            （<a
              href="https://chromewebstore.google.com/detail/d-op/mcjkaoagedekadnimbcbkhdkgpbnnodc"
              target="_blank"
              rel="noopener noreferrer"
              data-share-store="chrome">Chrome 版</a
            ><span class="sep"> / </span><a
              href="https://addons.mozilla.org/ja/firefox/addon/d-op/"
              target="_blank"
              rel="noopener noreferrer"
              data-share-store="firefox">Firefox 版</a
            >）
          </span>
        </p>
        <p class="share-copy-status" role="status" aria-live="polite" data-share-copy-status data-testid="copy-status"></p>
        <dialog
          class="install-dialog"
          aria-labelledby="install-dialog-title"
          data-share-install-dialog
          data-testid="install-dialog"
        >
          <button
            type="button"
            class="install-dialog-close"
            aria-label="閉じる"
            data-share-install-close
            data-testid="install-dialog-close"
          >
            ×
          </button>
          <h2 id="install-dialog-title" class="install-dialog-title">
            d-OP 拡張機能が必要です
          </h2>
          <p class="install-dialog-body">
            このプレイリストを保存するには、d-OP
            拡張機能をインストールしてください。インストールはこちらから:
          </p>
          <div class="button-row install-dialog-stores">
            <a
              class="button button-primary"
              href="https://chromewebstore.google.com/detail/d-op/mcjkaoagedekadnimbcbkhdkgpbnnodc"
              target="_blank"
              rel="noopener noreferrer"
              data-share-store="chrome"
              data-testid="save-chrome-link"
            >
              <svg class="store-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-5.344 9.257c.206.01.413.016.621.016 6.627 0 12-5.373 12-12 0-1.54-.29-3.011-.818-4.364zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728Z" />
              </svg>
              Chrome 版を入手
            </a>
            <a
              class="button button-secondary"
              href="https://addons.mozilla.org/ja/firefox/addon/d-op/"
              target="_blank"
              rel="noopener noreferrer"
              data-share-store="firefox"
              data-testid="save-firefox-link"
            >
              <svg class="store-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M8.824 7.287c.008 0 .004 0 0 0zm-2.8-1.4c.006 0 .003 0 0 0zm16.754 2.161c-.505-1.215-1.53-2.528-2.333-2.943.654 1.283 1.033 2.57 1.177 3.53l.002.02c-1.314-3.278-3.544-4.6-5.366-7.477-.091-.147-.184-.292-.273-.446a3.545 3.545 0 01-.13-.24 2.118 2.118 0 01-.172-.46.03.03 0 00-.027-.03.038.038 0 00-.021 0l-.006.001a.037.037 0 00-.01.005L15.624 0c-2.585 1.515-3.657 4.168-3.932 5.856a6.197 6.197 0 00-2.305.587.297.297 0 00-.147.37c.057.162.24.24.396.17a5.622 5.622 0 012.008-.523l.067-.005a5.847 5.847 0 011.957.222l.095.03a5.816 5.816 0 01.616.228c.08.036.16.073.238.112l.107.055a5.835 5.835 0 01.368.211 5.953 5.953 0 012.034 2.104c-.62-.437-1.733-.868-2.803-.681 4.183 2.09 3.06 9.292-2.737 9.02a5.164 5.164 0 01-1.513-.292 4.42 4.42 0 01-.538-.232c-1.42-.735-2.593-2.121-2.74-3.806 0 0 .537-2 3.845-2 .357 0 1.38-.998 1.398-1.287-.005-.095-2.029-.9-2.817-1.677-.422-.416-.622-.616-.8-.767a3.47 3.47 0 00-.301-.227 5.388 5.388 0 01-.032-2.842c-1.195.544-2.124 1.403-2.8 2.163h-.006c-.46-.584-.428-2.51-.402-2.913-.006-.025-.343.176-.389.206-.406.29-.787.616-1.136.974-.397.403-.76.839-1.085 1.303a9.816 9.816 0 00-1.562 3.52c-.003.013-.11.487-.19 1.073-.013.09-.026.181-.037.272a7.8 7.8 0 00-.069.667l-.002.034-.023.387-.001.06C.386 18.795 5.593 24 12.016 24c5.752 0 10.527-4.176 11.463-9.661.02-.149.035-.298.052-.448.232-1.994-.025-4.09-.753-5.844z" />
              </svg>
              Firefox 版を入手
            </a>
          </div>
          <p class="install-dialog-note">
            インストール後、このページを再読み込みすると「d-OP で開く」から保存できます。
          </p>
        </dialog>
        <noscript>
          <p class="share-noscript">
            ボタンの動作には JavaScript が必要です。URL:
            <code class="share-noscript-url">{result.view.canonicalUrl}</code>
          </p>
        </noscript>
      </section>

      <ShareItems items={result.view.items} />
      {result.view.remix.total > 0 && (
        <section class="share-remix" aria-labelledby="share-remix-title" data-testid="share-remix">
          <h2 id="share-remix-title" class="share-remix-title">
            このプレイリストの Remix（{result.view.remix.total}件）
          </h2>
          <ul class="share-remix-list">
            {result.view.remix.items.map((item) => (
              <li class="share-remix-item" data-testid="share-remix-item">
                <a href={item.url}>{item.title}</a>
                <span class="share-remix-meta">
                  {item.clipCount}クリップ・{item.publishedAtLabel}
                </span>
              </li>
            ))}
          </ul>
          {result.view.remix.nextUrl !== null && (
            <p class="share-remix-more">
              <a href={result.view.remix.nextUrl} data-testid="share-remix-next">
                次のページ
              </a>
            </p>
          )}
        </section>
      )}
      <script is:inline src="/share-page.js" defer></script>
    </>
  ) : result.kind === "unavailable" ? (
    <ErrorShell
      eyebrow={result.status === 429 ? "429 / BUSY" : "503 / UNAVAILABLE"}
      title="一時的に利用できません"
      message="しばらくしてからもう一度お試しください。"
    />
  ) : (
    <ErrorShell title={NOT_FOUND_TITLE} message={NOT_FOUND_MESSAGE} />
  )}
</ShellLayout>

<style>
  .share-hero {
    padding-block: var(--space-7) var(--space-8);
  }

  .share-title {
    max-inline-size: 100%;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .share-author {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-author::before {
    content: "by ";
    color: var(--color-subtle);
  }

  .share-description {
    max-inline-size: 42rem;
    margin-top: var(--space-4);
    color: var(--color-muted);
    overflow-wrap: break-word;
    white-space: pre-line;
  }

  .share-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-4);
    color: var(--color-subtle);
    font-size: var(--text-sm);
  }

  .share-meta strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .share-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .share-tag {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: break-word;
  }

  .share-source {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-source a {
    color: var(--color-info);
  }

  .share-actions {
    margin-top: var(--space-5);
  }

  .share-status-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-subtle);
    font-size: var(--text-sm);
  }

  .share-status-line .save-status {
    overflow-wrap: break-word;
  }

  .share-status-stores a {
    color: var(--color-info);
  }

  .share-copy-status {
    min-height: 1.5em;
    margin-top: var(--space-2);
    color: var(--color-success);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-noscript {
    margin-top: var(--space-3);
    color: var(--color-subtle);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-noscript-url {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: break-word;
    user-select: all;
  }

  .install-dialog {
    position: relative;
    max-width: min(26rem, calc(100vw - 2rem));
    padding: var(--space-6);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
  }

  .install-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(2px);
  }

  .install-dialog-title {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }

  .install-dialog-body {
    margin-top: var(--space-3);
    color: var(--color-muted);
    overflow-wrap: break-word;
  }

  .install-dialog-stores {
    margin-top: var(--space-5);
  }

  .store-icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  .install-dialog-note {
    margin-top: var(--space-4);
    color: var(--color-subtle);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .install-dialog-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1;
    cursor: pointer;
  }

  .install-dialog-close:hover {
    border-color: var(--color-line-strong);
    color: var(--color-ink);
  }

  .share-remix {
    padding-block: 0 var(--space-8);
  }

  .share-remix-title {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .share-remix-list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .share-remix-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .share-remix-item a {
    color: var(--color-info);
    font-weight: 600;
    overflow-wrap: break-word;
  }

  .share-remix-meta {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .share-remix-more {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .share-remix-more a {
    color: var(--color-info);
  }
</style>
