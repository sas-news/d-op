---
import ErrorShell from "../../components/ErrorShell.astro"
import ShareItems from "../../components/ShareItems.astro"
import ShellLayout from "../../layouts/ShellLayout.astro"
import { newRequestId } from "../../server/services/respond"
import { loadSharePage, SHARE_OG_IMAGE_URL } from "../../server/services/share-page"

// GET /p/:shareId — the public snapshot page (task 16). Fully server-rendered:
// every state (found / notfound / unavailable) is decided here and works with
// JavaScript disabled. Unknown, pending, blocked, deleted and malformed ids
// all render the SAME nonrevealing 404 view — no existence oracle. Manage
// secrets, capability URLs and admin controls never reach this markup.

const result = await loadSharePage(Astro.params["shareId"], Astro.request, newRequestId())

if (result.kind === "notfound") {
  Astro.response.status = 404
} else if (result.kind === "unavailable") {
  Astro.response.status = result.status
  if (result.retryAfter !== null) {
    Astro.response.headers.set("retry-after", result.retryAfter)
  }
}

const NOT_FOUND_TITLE = "共有プレイリストが見つかりません"
const NOT_FOUND_MESSAGE =
  "この共有プレイリストは存在しないか、公開されていません。URLを確認してください。"

const title =
  result.kind === "ready" ? `${result.view.title} | d-OP Share` : `${NOT_FOUND_TITLE} | d-OP Share`
const description =
  result.kind === "ready" ? result.view.ogDescription : "共有プレイリストは見つかりませんでした。"
---

<ShellLayout title={title} description={description}>
  <Fragment slot="head">
    {result.kind === "ready" ? (
      <>
        <link rel="canonical" href={result.view.canonicalUrl} />
        {(result.view.visibility === "unlisted" || result.view.remix.page > 1) && (
          <meta name="robots" content="noindex" />
        )}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="d-OP Share" />
        <meta property="og:title" content={result.view.ogTitle} />
        <meta property="og:description" content={result.view.ogDescription} />
        <meta property="og:url" content={result.view.canonicalUrl} />
        <meta property="og:image" content={SHARE_OG_IMAGE_URL} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={result.view.ogTitle} />
        <meta name="twitter:description" content={result.view.ogDescription} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
  </Fragment>

  {result.kind === "ready" ? (
    <>
      <section class="share-hero" aria-labelledby="share-title">
        <p class="hero-eyebrow" data-testid="share-visibility">
          {result.view.visibility === "public" ? "公開プレイリスト" : "限定公開プレイリスト"}
        </p>
        <h1 id="share-title" class="share-title" data-testid="share-title">
          {result.view.title}
        </h1>
        {result.view.author !== "" && (
          <p class="share-author" data-testid="share-author">
            {result.view.author}
          </p>
        )}
        {result.view.description !== "" && (
          <p class="share-description" data-testid="share-description">
            {result.view.description}
          </p>
        )}
        <p class="share-meta" data-testid="share-stats">
          <span>
            <strong data-testid="share-clip-count">{result.view.clipCount}</strong> クリップ
          </span>
          <span aria-hidden="true">·</span>
          <span>
            合計 <strong data-testid="share-total-duration">{result.view.totalDurationLabel}</strong>
          </span>
          <span aria-hidden="true">·</span>
          <span>{result.view.importCount} 回保存</span>
          <span aria-hidden="true">·</span>
          <span>{result.view.publishedAtLabel} 公開</span>
        </p>
        {result.view.tags.length > 0 && (
          <ul class="share-tags" data-testid="share-tags" aria-label="タグ">
            {result.view.tags.map((tag) => <li class="share-tag">{tag}</li>)}
          </ul>
        )}
        {result.view.sourceUrl !== null && (
          <p class="share-source" data-testid="share-source">
            このプレイリストは
            <a href={result.view.sourceUrl}>公開プレイリスト</a>
            の Remix です。
          </p>
        )}
        <div class="button-row share-actions" data-testid="save-panel">
          <button
            type="button"
            class="button button-primary"
            disabled
            aria-disabled="true"
            data-share-save
            data-share-id={result.view.shareId}
            data-testid="save-open-button"
          >
            d-OP で開く
          </button>
          <button
            type="button"
            class="button button-secondary"
            disabled
            aria-disabled="true"
            data-share-copy
            data-copy-url={result.view.canonicalUrl}
            data-testid="copy-url-button"
          >
            URLをコピー
          </button>
          <a
            class="button button-secondary"
            href={result.view.xIntentUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-testid="share-x-link"
          >
            Xで共有
          </a>
        </div>
        <p class="share-status-line">
          <span class="save-status" role="status" data-share-save-status data-testid="save-status">
            d-OP
            拡張機能が必要です。インストール後、このページを再読み込みしてください。
          </span>
          <span class="share-status-stores" data-share-stores>
            （<a
              href="https://chromewebstore.google.com/detail/d-op/mcjkaoagedekadnimbcbkhdkgpbnnodc"
              target="_blank"
              rel="noopener noreferrer"
              data-testid="save-chrome-link">Chrome 版</a
            >
            /
            <a
              href="https://addons.mozilla.org/ja/firefox/addon/d-op/"
              target="_blank"
              rel="noopener noreferrer"
              data-testid="save-firefox-link">Firefox 版</a
            >）
          </span>
        </p>
        <p class="share-copy-status" role="status" aria-live="polite" data-share-copy-status data-testid="copy-status"></p>
        <noscript>
          <p class="share-noscript">
            ボタンの動作には JavaScript が必要です。URL:
            <code class="share-noscript-url">{result.view.canonicalUrl}</code>
          </p>
        </noscript>
      </section>

      <ShareItems items={result.view.items} />
      {result.view.remix.total > 0 && (
        <section class="share-remix" aria-labelledby="share-remix-title" data-testid="share-remix">
          <h2 id="share-remix-title" class="share-remix-title">
            このプレイリストの Remix（{result.view.remix.total}件）
          </h2>
          <ul class="share-remix-list">
            {result.view.remix.items.map((item) => (
              <li class="share-remix-item" data-testid="share-remix-item">
                <a href={item.url}>{item.title}</a>
                <span class="share-remix-meta">
                  {item.clipCount}クリップ・{item.publishedAtLabel}
                </span>
              </li>
            ))}
          </ul>
          {result.view.remix.nextUrl !== null && (
            <p class="share-remix-more">
              <a href={result.view.remix.nextUrl} data-testid="share-remix-next">
                次のページ
              </a>
            </p>
          )}
        </section>
      )}
      <script is:inline src="/share-page.js" defer></script>
    </>
  ) : result.kind === "unavailable" ? (
    <ErrorShell
      eyebrow={result.status === 429 ? "429 / BUSY" : "503 / UNAVAILABLE"}
      title="一時的に利用できません"
      message="しばらくしてからもう一度お試しください。"
    />
  ) : (
    <ErrorShell title={NOT_FOUND_TITLE} message={NOT_FOUND_MESSAGE} />
  )}
</ShellLayout>

<style>
  .share-hero {
    padding-block: var(--space-7) var(--space-8);
  }

  .share-title {
    max-inline-size: 100%;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .share-author {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-author::before {
    content: "by ";
    color: var(--color-subtle);
  }

  .share-description {
    max-inline-size: 42rem;
    margin-top: var(--space-4);
    color: var(--color-muted);
    overflow-wrap: break-word;
    white-space: pre-line;
  }

  .share-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-4);
    color: var(--color-subtle);
    font-size: var(--text-sm);
  }

  .share-meta strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .share-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .share-tag {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: break-word;
  }

  .share-source {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-source a {
    color: var(--color-info);
  }

  .share-actions {
    margin-top: var(--space-5);
  }

  .share-status-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-subtle);
    font-size: var(--text-sm);
  }

  .share-status-line .save-status {
    overflow-wrap: break-word;
  }

  .share-status-stores a {
    color: var(--color-info);
  }

  .share-copy-status {
    min-height: 1.5em;
    margin-top: var(--space-2);
    color: var(--color-success);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-noscript {
    margin-top: var(--space-3);
    color: var(--color-subtle);
    font-size: var(--text-sm);
    overflow-wrap: break-word;
  }

  .share-noscript-url {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: break-word;
    user-select: all;
  }

  .share-remix {
    padding-block: 0 var(--space-8);
  }

  .share-remix-title {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .share-remix-list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .share-remix-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .share-remix-item a {
    color: var(--color-info);
    font-weight: 600;
    overflow-wrap: break-word;
  }

  .share-remix-meta {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .share-remix-more {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .share-remix-more a {
    color: var(--color-info);
  }
</style>
