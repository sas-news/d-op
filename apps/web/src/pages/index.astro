---
import Button from "../components/Button.astro"
import Card from "../components/Card.astro"
import ShellLayout from "../layouts/ShellLayout.astro"
---

<ShellLayout title="d-OP | dアニメストアでOPだけ再生する拡張機能" description="dアニメストアの動画からOP/EDを抽出して連続再生できるブラウザ拡張機能 d-OP の公式サイト。">
  <section class="hero" id="top" aria-labelledby="page-title">
    <div>
      <p class="hero-eyebrow">Chrome / Firefox 対応</p>
      <h1 id="page-title"><span>dアニメストア</span>のOPを、<span>もっと自由に。</span></h1>
      <p class="hero-lede">作品一覧からワンクリックでOP/ED区間を選択し、プレイリストを作成して連続再生できるブラウザ拡張機能です。</p>
      <div class="hero-actions">
        <Button href="#download" testId="download-link">ダウンロード</Button>
        <Button href="https://github.com/sas-news/d-op" variant="secondary">GitHub を見る</Button>
        <Button href="/fixtures/shell" variant="secondary" testId="shell-fixture-link">状態のサンプル</Button>
      </div>
    </div>
    <div class="hero-art" aria-label="d-OPの再生範囲を表すプレビュー">
      <div class="art-window">
        <div class="art-window-head"><span>d-OP / PLAYLIST</span><span>● READY</span></div>
        <div class="art-lines" aria-hidden="true"><span class="art-line"></span><span class="art-line"></span><span class="art-line"></span></div>
      </div>
    </div>
  </section>

  <section class="section" id="gallery" aria-labelledby="gallery-title">
    <div class="section-heading"><div><p class="section-eyebrow">How it works</p><h2 id="gallery-title">見たいシーンだけを、すぐに。</h2></div><p>作品一覧のボタン、シークバーのマーカー、プレイリスト。毎日の再生を小さく整えます。</p></div>
    <div class="card-grid">
      <Card heading="範囲を選ぶ"><p>作品一覧からOP・EDを選び、好きな区間をプレイリストに追加します。</p></Card>
      <Card heading="続けて楽しむ"><p>複数の作品から選んだ範囲をまとめて、スムーズに連続再生できます。</p></Card>
      <Card heading="手元で管理する"><p>プレイリストはブラウザのローカルストレージに保存。外部送信を前提にしません。</p></Card>
    </div>
  </section>

  <section class="section" id="download" aria-labelledby="download-title">
    <div class="section-heading"><div><p class="section-eyebrow">Store links</p><h2 id="download-title">ブラウザに追加する</h2></div><p>お使いのブラウザに合わせてインストールしてください。</p></div>
    <div class="store-grid">
      <a class="store-card" data-testid="chrome-store-link" href="https://chromewebstore.google.com/detail/d-op/mcjkaoagedekadnimbcbkhdkgpbnnodc" rel="noopener" target="_blank"><span class="store-badge" aria-hidden="true">CH</span><span class="store-body"><span class="store-label">CHROME WEB STORE</span><span class="store-title">Chrome 版を入手</span><span class="store-desc">Chrome / Vivaldi / Brave などのChromium系ブラウザに対応。</span></span><span class="store-arrow" aria-hidden="true">→</span></a>
      <a class="store-card" data-testid="firefox-store-link" href="https://addons.mozilla.org/ja/firefox/addon/d-op/" rel="noopener" target="_blank"><span class="store-badge" aria-hidden="true">FX</span><span class="store-body"><span class="store-label">FIREFOX ADD-ONS</span><span class="store-title">Firefox 版を入手</span><span class="store-desc">Firefox / Zen Browser / Floorp などのGecko系ブラウザに対応。</span></span><span class="store-arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" id="privacy" aria-labelledby="privacy-title">
    <div class="section-heading"><div><p class="section-eyebrow">Privacy</p><h2 id="privacy-title">静かなプライバシー</h2></div><p>アカウントや再生履歴を要求する画面は、このWebシェルにはありません。</p></div>
    <div class="notice notice-info" role="status"><strong>ローカル中心の設計</strong><p>必要な範囲だけを、明確に扱います。共有データやアカウント操作は後続タスクで実装します。</p></div>
  </section>
</ShellLayout>
