---
import "../styles/tokens.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {/* Page-scoped head entries (canonical, robots, OGP). Values placed in
        attributes/text by pages are escaped by Astro — no set:html here. */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-testid="skip-link">メインコンテンツへスキップ</a>
    <header class="site-header" data-testid="site-header">
      <a class="brand" href="/" aria-label="d-OP ホーム">
        <img class="brand-icon" src="/assets/d-OP-icon.png" width="40" height="40" alt="" />
        <span class="brand-copy"><span class="brand-name">d-OP</span><span class="brand-version">v1.0.0</span></span>
      </a>
      <nav class="site-nav" aria-label="サイト内メニュー">
        <a href="/#gallery">できること</a>
        <a href="/#download">ダウンロード</a>
        <a href="/#support">サポート</a>
        <a href="/explore">Explore</a>
        <a href="/privacy">プライバシー</a>
      </nav>
    </header>
    <main id="main-content" class="page-wrap" data-testid="site-main">
      <slot />
    </main>
    <footer class="site-footer" data-testid="site-footer">
      <div class="footer-meta">
        <span>© 2026 sasnews</span>
        <span>d-OP は dアニメストアの非公式拡張機能です。dアニメストアおよび株式会社NTTドコモとは一切関係ありません。</span>
      </div>
      <ul class="footer-links">
        <li><a href="/">ホーム</a></li>
        <li><a href="/explore">Explore</a></li>
        <li><a href="/privacy">プライバシー</a></li>
        <li><a href="/#share">シェア</a></li>
        <li><a href="https://github.com/sas-news/d-op" rel="noopener" target="_blank">GitHub</a></li>
        <li><a href="https://github.com/sas-news/d-op/blob/main/LICENSE" rel="noopener" target="_blank">MIT ライセンス</a></li>
      </ul>
    </footer>
  </body>
</html>
