{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/shared/src",
    "packages/shared/tests",
    "apps/web/src",
    "apps/web/tests",
    "apps/web/vitest.worker.config.ts",
    "vitest.unit.config.ts",
    "playwright.config.ts",
    "tests/e2e/harness.spec.ts",
    "tests/e2e/extension-storage.spec.ts",
    "tests/e2e/extension-player-state.spec.ts",
    "tests/e2e/web-shell.spec.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/.output", "**/.wxt", "**/.astro"],
  "compilerOptions": {
